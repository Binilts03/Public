+            .contains("- pdf: Create PDF documents and reports.")
+    );
+
+    let tools = registry.tool_contributors()[0].tools(&session_store, &thread_store);
+    let search_tool = tools
+        .iter()
+        .find(|tool| tool.tool_name().name == "search")
+        .ok_or("skills.search tool should be registered")?;
+    let search_payload = ToolPayload::Function {
+        arguments: serde_json::json!({"goal": "use filler-30"}).to_string(),
+    };
+    let output = search_tool
+        .handle(ToolCall {
+            turn_id: "turn-2".to_string(),
+            call_id: "search-1".to_string(),
+            tool_name: search_tool.tool_name(),
+            model: "gpt-test".to_string(),
+            truncation_policy: TruncationPolicy::Bytes(1_024),
+            conversation_history: ConversationHistory::default(),
+            turn_item_emitter: Arc::new(NoopTurnItemEmitter),
+            environments: Vec::new(),
+            payload: search_payload.clone(),
+        })
+        .await?;
+    let response = output
+        .post_tool_use_response("search-1", &search_payload)
+        .ok_or("skills.search should expose structured output")?;
+    assert_eq!(response["matches"][0]["name"], "filler-30");
+    Ok(())
