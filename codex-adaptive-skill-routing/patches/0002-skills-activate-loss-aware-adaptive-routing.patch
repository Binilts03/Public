+fn lexical_selector_recovers_typo_and_unsegmented_cjk_matches() {
+    let documents = [
+        SkillSelectionDocument {
+            id: 1,
+            name: "security-review",
+            short_description: None,
+            description: "Review code for security defects.",
+        },
+        SkillSelectionDocument {
+            id: 2,
+            name: "pdf",
+            short_description: None,
+            description: "创建和编辑PDF文档",
+        },
+    ];
+
+    assert_eq!(
+        vec![1],
+        WeightedLexicalSkillSelector
+            .select("securty review", &documents, 1)
+            .candidate_ids
+    );
+    assert_eq!(
+        vec![2],
+        WeightedLexicalSkillSelector
+            .select("请创建PDF文档", &documents, 1)
+            .candidate_ids
+    );
+}
