+
+    assert_eq!(1, fragments.len());
+    let rendered = fragments[0].render();
+    assert!(rendered.contains("- pdf: Create PDF documents and reports."));
+    assert!(!rendered.contains("filler-"));
+
+    let continuation = registry.turn_input_contributors()[0]
+        .contribute(
+            TurnInputContext {
+                turn_id: "turn-2".to_string(),
+                user_input: vec![UserInput::Text {
+                    text: "do the same here".to_string(),
