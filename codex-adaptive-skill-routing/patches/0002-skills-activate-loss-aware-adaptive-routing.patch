+fn routing_description(entry: &crate::catalog::SkillCatalogEntry) -> String {
+    let mut text = String::new();
+    for value in [
+        entry.description.as_str(),
+        entry.authority.id.as_str(),
+        entry.id.0.as_str(),
+        entry.rendered_path(),
+    ] {
+        push_routing_hint(&mut text, value);
+    }
+    if let Some(scope) = entry.scope {
+        push_routing_hint(&mut text, &format!("{scope:?}"));
+    }
+    if let Some(plugin_id) = entry.plugin_id.as_deref() {
+        push_routing_hint(&mut text, plugin_id);
+    }
+    if let Some(dependencies) = &entry.dependencies {
+        for dependency in &dependencies.tools {
+            for value in [
+                Some(dependency.r#type.as_str()),
+                Some(dependency.value.as_str()),
+                dependency.description.as_deref(),
+                dependency.transport.as_deref(),
+                dependency.command.as_deref(),
+                dependency.url.as_deref(),
+            ]
+            .into_iter()
+            .flatten()
+            {
+                push_routing_hint(&mut text, value);
+            }
+        }
+    }
+    text
+}
+
+fn push_routing_hint(destination: &mut String, value: &str) {
+    if destination.len() >= MAX_ROUTING_DESCRIPTION_BYTES {
+        return;
+    }
+    if !destination.is_empty() {
+        destination.push(' ');
+    }
+    let remaining = MAX_ROUTING_DESCRIPTION_BYTES.saturating_sub(destination.len());
+    let mut end = remaining.min(value.len());
+    while !value.is_char_boundary(end) {
+        end = end.saturating_sub(1);
+    }
+    destination.push_str(&value[..end]);
+}
+
+impl ShadowSelectionTurnState {
+    pub(crate) fn candidate_ids(&self, limit: usize) -> impl Iterator<Item = usize> + '_ {
+        self.ranked_selections
+            .first()
+            .into_iter()
+            .flat_map(|selection| selection.candidate_ids.iter().copied())
+            .take(limit)
+    }
+}
