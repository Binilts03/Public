-    score.saturating_add(matched_query_terms.saturating_mul(matched_query_terms))
+    let ngram_score = ngram_overlap(query_ngrams, &name)
+        .saturating_mul(8)
+        .saturating_add(ngram_overlap(query_ngrams, &short_description).saturating_mul(3))
+        .saturating_add(ngram_overlap(query_ngrams, &description))
+        .min(64);
+    score
+        .saturating_add(matched_query_terms.saturating_mul(matched_query_terms))
+        .saturating_add(ngram_score)
+}
+
+fn character_ngrams(value: &str) -> HashSet<String> {
+    let characters = value
+        .chars()
+        .filter(|character| !character.is_whitespace())
+        .take(256)
+        .collect::<Vec<_>>();
+    characters
+        .windows(3)
+        .take(256)
+        .map(|window| window.iter().collect())
+        .collect()
+}
+
+fn ngram_overlap(query: &HashSet<String>, value: &str) -> u32 {
+    let value = character_ngrams(value);
+    u32::try_from(query.intersection(&value).count()).unwrap_or(u32::MAX)
 }
 
 fn normalize_bounded(value: &str) -> String {
