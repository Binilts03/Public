+pub(crate) fn recovery_skills_fragment(
+    include_skills_usage_instructions: bool,
+) -> AvailableSkillsInstructions {
+    AvailableSkillsInstructions::from_skill_lines(
+        vec!["- No strong initial match. Use `skills.search` to search the enabled skill catalogue for this task.".to_string()],
+        include_skills_usage_instructions,
+    )
+}
+
+fn render_catalog(catalog: &SkillCatalog) -> Option<codex_core_skills::AvailableSkills> {
+    let entries = catalog
+        .entries
+        .iter()
+        .filter(|entry| entry.enabled && entry.prompt_visible)
+        .map(|entry| {
+            let description = entry
+                .short_description
+                .as_deref()
+                .unwrap_or(entry.description.as_str());
+            SkillRenderEntry::new(
+                &entry.name,
+                description,
+                locator_kind(entry),
+                entry.rendered_path(),
+            )
+        })
+        .collect::<Vec<_>>();
+    build_available_skills_from_entries(
+        &entries,
+        SkillMetadataBudget::Characters(MAX_AVAILABLE_SKILLS_CHARS),
+    )
+}
