diff --git a/codex-rs/ext/skills/src/tools/read_tests.rs b/codex-rs/ext/skills/src/tools/read_tests.rs
new file mode 100644
index 0000000..f8056e0
--- /dev/null
+++ b/codex-rs/ext/skills/src/tools/read_tests.rs
@@ -0,0 +1,21 @@
+use super::page;
+
+#[test]
+fn paginated_utf8_reads_reassemble_without_loss() {
+    let original = "a🙂b界c";
+    let mut offset = 0;
+    let mut rebuilt = String::new();
+
+    loop {
+        let (contents, next_offset) = page(original, offset, 2).expect("valid page");
+        assert!(!contents.is_empty());
+        rebuilt.push_str(&contents);
+        let Some(next_offset) = next_offset else {
+            break;
+        };
+        assert!(next_offset > offset);
+        offset = next_offset;
+    }
+
+    assert_eq!(rebuilt, original);
+}
