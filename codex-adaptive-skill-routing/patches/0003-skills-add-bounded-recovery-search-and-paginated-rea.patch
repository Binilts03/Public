+++ b/codex-rs/ext/skills/src/tools/search.rs
@@ -0,0 +1,154 @@
+use codex_extension_api::FunctionCallError;
+use codex_extension_api::ToolCall;
+use codex_extension_api::ToolExecutor;
+use codex_extension_api::ToolExecutorFuture;
+use codex_extension_api::ToolName;
+use codex_extension_api::ToolSpec;
+use codex_protocol::user_input::UserInput;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+
+use crate::render::truncate_catalog_skill_description;
+
+use super::SkillToolAuthority;
+use super::SkillToolContext;
+use super::external_json_output;
+use super::is_bounded_handle;
+use super::parse_args;
+use super::skill_function_tool;
+use super::skill_tool_name;
+
+const TOOL_NAME: &str = "search";
+const MAX_GOAL_BYTES: usize = 4 * 1024;
+const MAX_RESULTS: usize = 8;
+const MAX_EXCLUDED_REFS: usize = 16;
+const MAX_RESPONSE_METADATA_BYTES: usize = 8 * 1024;
+
+#[derive(Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+struct SearchArgs {
+    goal: String,
+    #[serde(default)]
+    excluded_skill_refs: Vec<String>,
+}
+
+#[derive(Debug, Eq, JsonSchema, PartialEq, Serialize)]
+#[schemars(deny_unknown_fields)]
+struct SearchMatch {
+    skill_ref: String,
+    authority: SkillToolAuthority,
+    package: String,
+    name: String,
+    description: String,
+    main_resource: String,
+}
+
+#[derive(Debug, Eq, JsonSchema, PartialEq, Serialize)]
+#[schemars(deny_unknown_fields)]
+struct SearchResponse {
+    matches: Vec<SearchMatch>,
+}
+
+#[derive(Clone)]
+pub(super) struct SearchTool {
+    pub(super) context: SkillToolContext,
+}
+
+impl ToolExecutor<ToolCall> for SearchTool {
+    fn tool_name(&self) -> ToolName {
+        skill_tool_name(TOOL_NAME)
+    }
+
+    fn spec(&self) -> ToolSpec {
+        skill_function_tool::<SearchArgs, SearchResponse>(
+            TOOL_NAME,
+            "Search the enabled skill catalog for the current turn when the initially listed skills do not cover the task. Results are metadata only; pass the returned authority, package, and main_resource to skills.read.",
+        )
+    }
+
+    fn handle(&self, call: ToolCall) -> ToolExecutorFuture<'_> {
+        Box::pin(async move {
+            let args: SearchArgs = parse_args(&call)?;
+            if args.goal.is_empty() || args.goal.len() > MAX_GOAL_BYTES {
+                return Err(FunctionCallError::RespondToModel(format!(
+                    "goal must be non-empty and at most {MAX_GOAL_BYTES} bytes"
+                )));
+            }
+            if args.excluded_skill_refs.len() > MAX_EXCLUDED_REFS {
+                return Err(FunctionCallError::RespondToModel(format!(
+                    "excluded_skill_refs accepts at most {MAX_EXCLUDED_REFS} values"
+                )));
+            }
+            let Some((catalog, _)) = self.context.thread_state.routing_turn(&call.turn_id) else {
+                return Err(FunctionCallError::RespondToModel(
+                    "the skill catalog snapshot for this turn is unavailable".to_string(),
+                ));
+            };
+            let input = [UserInput::Text {
+                text: args.goal,
+                text_elements: Vec::new(),
+            }];
+            let selection = self.context.shadow_selection.run(&input, &catalog);
+            let candidates = selection
+                .candidate_ids(50)
+                .filter_map(|id| catalog.entries.get(id))
+                .filter(|entry| {
+                    !args
+                        .excluded_skill_refs
+                        .iter()
+                        .any(|excluded| excluded == entry.main_prompt.as_str())
+                })
+                .filter(|entry| {
+                    SkillToolAuthority::from_authority(&entry.authority).is_some()
+                        && is_bounded_handle(&entry.authority.id, super::MAX_HANDLE_BYTES)
+                        && is_bounded_handle(&entry.id.0, super::MAX_HANDLE_BYTES)
+                        && is_bounded_handle(entry.main_prompt.as_str(), super::MAX_HANDLE_BYTES)
+                })
+                .collect::<Vec<_>>();
+            let accepted = self
+                .context
+                .thread_state
+                .register_recovery_search(
+                    &call.turn_id,
+                    candidates
+                        .iter()
+                        .map(|entry| entry.main_prompt.as_str().to_string()),
+                    MAX_RESULTS,
+                )
+                .map_err(|message| FunctionCallError::RespondToModel(message.to_string()))?;
+            let mut matches = Vec::new();
+            let mut metadata_bytes = 0usize;
+            for entry in candidates
+                .into_iter()
+                .filter(|entry| accepted.contains(entry.main_prompt.as_str()))
+            {
+                let Some(authority) = SkillToolAuthority::from_authority(&entry.authority) else {
+                    continue;
+                };
+                let candidate = SearchMatch {
+                    skill_ref: entry.main_prompt.as_str().to_string(),
+                    authority,
+                    package: entry.id.0.clone(),
+                    name: entry.name.clone(),
+                    description: truncate_catalog_skill_description(&entry.description)
+                        .into_owned(),
+                    main_resource: entry.main_prompt.as_str().to_string(),
+                };
+                let candidate_bytes = serde_json::to_vec(&candidate)
+                    .map_err(|err| FunctionCallError::Fatal(err.to_string()))?
+                    .len();
+                if metadata_bytes.saturating_add(candidate_bytes) > MAX_RESPONSE_METADATA_BYTES {
+                    continue;
+                }
+                metadata_bytes = metadata_bytes.saturating_add(candidate_bytes);
+                matches.push(candidate);
+                if matches.len() == MAX_RESULTS {
+                    break;
+                }
+            }
+
+            external_json_output(&SearchResponse { matches })
+        })
+    }
+}
