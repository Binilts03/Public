+
+fn default_page_bytes() -> usize {
+    DEFAULT_PAGE_BYTES
+}
+
+fn page(
+    contents: &str,
+    offset: usize,
+    limit: usize,
+) -> Result<(String, Option<usize>), FunctionCallError> {
+    if offset > contents.len() || !contents.is_char_boundary(offset) {
+        return Err(FunctionCallError::RespondToModel(
+            "offset must be a UTF-8 boundary within the resource".to_string(),
+        ));
+    }
+    let mut end = offset.saturating_add(limit).min(contents.len());
+    while end > offset && !contents.is_char_boundary(end) {
+        end = end.saturating_sub(1);
+    }
+    if end == offset && offset < contents.len() {
+        end = offset.saturating_add(contents[offset..].chars().next().map_or(0, char::len_utf8));
+    }
+    let next_offset = (end < contents.len()).then_some(end);
+    Ok((contents[offset..end].to_string(), next_offset))
+}
