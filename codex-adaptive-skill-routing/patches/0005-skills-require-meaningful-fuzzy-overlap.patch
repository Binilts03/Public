From 7acbf91d3b9e3914d02890d9de9155c22f961423 Mon Sep 17 00:00:00 2001
From: Binilts03 <81070341+Binilts03@users.noreply.github.com>
Date: Mon, 13 Jul 2026 21:39:41 +0530
Subject: [PATCH] skills: require meaningful fuzzy overlap

---
 .../src/dynamic_skill_selector/weighted_lexical.rs       | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/codex-rs/ext/skills/src/dynamic_skill_selector/weighted_lexical.rs b/codex-rs/ext/skills/src/dynamic_skill_selector/weighted_lexical.rs
index 84549a2..53073a9 100644
--- a/codex-rs/ext/skills/src/dynamic_skill_selector/weighted_lexical.rs
+++ b/codex-rs/ext/skills/src/dynamic_skill_selector/weighted_lexical.rs
@@ -155,7 +155,14 @@ fn character_ngrams(value: &str) -> HashSet<String> {
 
 fn ngram_overlap(query: &HashSet<String>, value: &str) -> u32 {
     let value = character_ngrams(value);
-    u32::try_from(query.intersection(&value).count()).unwrap_or(u32::MAX)
+    let overlap = query.intersection(&value).count();
+    let shorter = query.len().min(value.len());
+    // ponytail: fuzzy matching stays deliberately conservative. If this ceiling
+    // hurts recall, replace it with a measured edit-distance implementation.
+    if overlap < 3 || overlap.saturating_mul(2) < shorter {
+        return 0;
+    }
+    u32::try_from(overlap).unwrap_or(u32::MAX)
 }
 
 fn normalize_bounded(value: &str) -> String {
