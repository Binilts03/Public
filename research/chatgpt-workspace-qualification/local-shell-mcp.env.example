# Candidate: fwerkor/local-shell-mcp @ dec01b9f50f966097ddfc84d357d12a52f238935
# TESTED CONFIGURATION SHAPE, NOT AN INSTALLED OR AUTHORIZED PRODUCTION ENDPOINT.
# Run with dedicated low-privilege Linux user and OS-enforced filesystem/network isolation.
# Store operator secrets in a protected secret manager, NEVER in this file or GitHub.
LOCAL_SHELL_MCP_MODE=mcp
LOCAL_SHELL_MCP_HOST=127.0.0.1
LOCAL_SHELL_MCP_PORT=8765
LOCAL_SHELL_MCP_WORKSPACE_ROOT=/srv/chatgpt-coder/workspaces/public
LOCAL_SHELL_MCP_STATE_DIR=/srv/chatgpt-coder/state
LOCAL_SHELL_MCP_AGENT_CONFIG_DIR=/srv/chatgpt-coder/skills
LOCAL_SHELL_MCP_STATE_BACKEND=file
LOCAL_SHELL_MCP_AUTH_MODE=oauth
LOCAL_SHELL_MCP_AUTH_BYPASS_LOCALHOST=false
LOCAL_SHELL_MCP_REQUIRE_AUTH_FOR_MCP_DISCOVERY=true
LOCAL_SHELL_MCP_OAUTH_ACCESS_TOKEN_TTL_S=86400
LOCAL_SHELL_MCP_REMOTE_ENABLED=false
LOCAL_SHELL_MCP_REMOTE_PEER_TRANSFER_ENABLED=false
LOCAL_SHELL_MCP_ALLOW_FULL_CONTAINER=false
LOCAL_SHELL_MCP_UI_ENABLED=false
LOCAL_SHELL_MCP_LIVE_WORKSPACE_ENABLED=false
LOCAL_SHELL_MCP_MAX_CONCURRENT_COMMANDS=2
LOCAL_SHELL_MCP_MAX_TMUX_SESSIONS=4
# Set securely at deployment, not in this tracked template:
# LOCAL_SHELL_MCP_PUBLIC_BASE_URL=https://YOUR-AUTHENTICATED-HOST
# LOCAL_SHELL_MCP_OAUTH_ADMIN_PIN=(long random secret)
# LOCAL_SHELL_MCP_OAUTH_JWT_SECRET=(long random 32+ byte secret)
